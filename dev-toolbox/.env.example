# SuperAuth 配置示例
# 复制此文件为 .env 并修改为实际地址

# Gateway API 地址（用于直接登录模式）
# 默认: http://localhost:4000
VITE_GATEWAY_URL=http://localhost:4000

# Portal 地址（用于统一认证模式）
# 如果您部署了SuperAuth Portal，填写Portal地址
# 默认: http://localhost
VITE_PORTAL_URL=http://localhost

# 当前应用地址（用于回调）
# 默认: http://localhost:3100
VITE_APP_URL=http://localhost:3100
