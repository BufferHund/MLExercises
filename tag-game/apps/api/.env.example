# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL="file:./dev.db"

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Upload
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=4

# WebSocket
WS_HEARTBEAT=20000

# Game Settings
MAX_CAPTURE_DISTANCE_METERS=5
POSITION_UPDATE_COOLDOWN_SEC=3
NEARBY_RADIUS_METERS=15
